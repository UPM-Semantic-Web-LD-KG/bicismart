PREFIX bm:   <https://bicismart.madrid.data.es/ontology#>
PREFIX geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Estaciones que se pueden usar: activadas, en servicio y con alguna base útil.
SELECT ?station ?id ?name ?lat ?lon ?capacity ?unavailable
WHERE {
  ?station a bm:BikeStation ;
           bm:stationId ?id ;
           rdfs:label ?name ;
           bm:totalCapacity ?capacity ;
           bm:hasPoint ?point ;
           bm:hasState ?stationState .
  ?point geo:lat ?lat ;
         geo:long ?lon .
  ?stationState bm:isActivated true ;
                bm:operationalState "IN_SERVICE" ;
                bm:unavailableBases ?unavailable .
  FILTER (?capacity - ?unavailable > 0)
}
